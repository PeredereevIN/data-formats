# syntax=docker/dockerfile:1.7

FROM ubuntu:24.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        lsb-release \
        wget \
    && wget -q "https://packages.apache.org/artifactory/arrow/$(lsb_release --id --short | tr 'A-Z' 'a-z')/apache-arrow-apt-source-latest-$(lsb_release --codename --short).deb" \
    && apt-get install -y --no-install-recommends ./apache-arrow-apt-source-latest-$(lsb_release --codename --short).deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends libarrow-dev libparquet-dev \
    && rm -rf /var/lib/apt/lists/* apache-arrow-apt-source-latest-*.deb

WORKDIR /app
COPY CMakeLists.txt ./
COPY src ./src

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --parallel

FROM ubuntu:24.04 AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        lsb-release \
        wget \
        libstdc++6 \
    && wget -q "https://packages.apache.org/artifactory/arrow/$(lsb_release --id --short | tr 'A-Z' 'a-z')/apache-arrow-apt-source-latest-$(lsb_release --codename --short).deb" \
    && apt-get install -y --no-install-recommends ./apache-arrow-apt-source-latest-$(lsb_release --codename --short).deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends libarrow2500 libparquet2500 \
    && rm -rf /var/lib/apt/lists/* apache-arrow-apt-source-latest-*.deb

WORKDIR /app
COPY --from=builder /app/build/parquet_generator /app/parquet_generator

ENV OUTPUT_DIR=/data/parquet/batches
ENV BATCHES=250
ENV ROWS_PER_BATCH=1000000
ENV ROW_GROUP_SIZE=128000
ENV CODEC=zstd
ENV ZSTD_LEVEL=3
ENV BROTLI_LEVEL=5
ENV GZIP_LEVEL=6
ENV GENERATE_ALL=false
ENV DATA_PROFILE=mixed_v2
ENV MODE=generate
ENV DEEP_VALIDATE=false

ENTRYPOINT ["/app/parquet_generator"]
