FROM python:3.12-slim

ARG VORTEX_VERSION=0.86.1
ARG PYARROW_VERSION=25.0.1

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Wheels only: never silently fall back to a Rust/source build.
RUN python -m pip install --no-cache-dir --only-binary=:all: \
        "vortex-data==${VORTEX_VERSION}" \
        "pyarrow==${PYARROW_VERSION}"

COPY scripts/vortex_converter.py /app/vortex_converter.py

ENV PARQUET_INPUT_DIR=/data/parquet/batches/zstd \
    VORTEX_OUTPUT_DIR=/data/vortex/batches \
    BATCHES=250 \
    ROWS_PER_BATCH=1000000 \
    READ_BATCH_SIZE=65536 \
    VORTEX_STRATEGY=btrblocks \
    VORTEX_MAX_THREADS= \
    VORTEX_OVERWRITE=true \
    VORTEX_VALIDATE=true

ENTRYPOINT ["python", "/app/vortex_converter.py"]
