# Dataset
BATCHES=250
ROWS_PER_BATCH=1000000
READ_BATCH_SIZE=65536
ROW_GROUP_SIZE=128000

# Parquet
CODEC=zstd
ZSTD_LEVEL=3
BROTLI_LEVEL=5
GZIP_LEVEL=6
GENERATE_ALL=false
DATA_PROFILE=mixed_v2
CONVERTER_WORKERS=2

# Library versions
PYARROW_VERSION=25.0.1
VORTEX_VERSION=0.86.1
LANCE_VERSION=12.0.0

# Vortex
VORTEX_STRATEGY=btrblocks
VORTEX_MAX_THREADS=
VORTEX_OVERWRITE=true
VORTEX_VALIDATE=true

# Lance
LANCE_MAX_ROWS_PER_GROUP=128000
LANCE_MAX_ROWS_PER_FILE=1000000
LANCE_STORAGE_VERSION=2.2
LANCE_OVERWRITE=true
LANCE_VALIDATE=true
LANCE_LOG=warn

# Integrity
FAIL_FAST=false

# Benchmark
WARMUP=1
RUNS=0
BENCH_THREADS=
BENCH_FORMATS=parquet,vortex,lance
CASE=all
POINTS=128
SINGLE_BATCH=125
PARQUET_CODEC_DIR=zstd
